{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mobile: Debug in Expo",
      "type": "reactnative",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "platform": "expo",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Mobile: Attach to Packager",
      "type": "reactnative",
      "request": "attach",
      "cwd": "${workspaceFolder}",
      "port": 19000,
      "sourceMaps": true
    },
    {
      "name": "Mobile: Debug Android",
      "type": "reactnative",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "platform": "android",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Mobile: Debug iOS",
      "type": "reactnative",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "platform": "ios",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
