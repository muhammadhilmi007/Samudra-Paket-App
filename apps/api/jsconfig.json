{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "checkJs": true,
    "allowJs": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "types": ["node", "express", "cors"]
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules"]
}
