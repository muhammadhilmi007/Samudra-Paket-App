{
  "folders": [
    {
      "name": "✨ root",
      "path": "."
    },
    {
      "name": "🌐 web",
      "path": "apps/web"
    },
    {
      "name": "📱 mobile",
      "path": "apps/mobile"
    },
    {
      "name": "🚀 api",
      "path": "apps/api"
    },
    {
      "name": "📦 packages",
      "path": "packages"
    },
    {
      "name": "🔧 config",
      "path": "config"
    },
    {
      "name": "📝 docs",
      "path": "docs"
    }
  ],
  "settings": {
    // Editor settings
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.rulers": [100],
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.suggestSelection": "first",
    "editor.wordWrap": "off",
    "editor.linkedEditing": true,
    "editor.stickyScroll.enabled": true,

    // Files settings
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.exclude": {
      "**/.git": true,
      "**/.DS_Store": true,
      "**/node_modules": true,
      "**/.turbo": true,
      "**/dist": true,
      "**/build": true,
      "**/.next": true,
      "**/coverage": true
    },
    "files.associations": {
      "*.jsx": "javascriptreact",
      "*.tsx": "typescriptreact",
      "*.json": "json",
      "*.js": "javascript",
      "*.ts": "typescript"
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/node_modules/**": true,
      "**/.turbo/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/.next/**": true
    },

    // JavaScript/TypeScript settings
    "javascript.updateImportsOnFileMove.enabled": "always",
    "typescript.updateImportsOnFileMove.enabled": "always",
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "typescript.preferences.importModuleSpecifier": "shortest",
    "typescript.preferences.quoteStyle": "single",
    "javascript.preferences.quoteStyle": "single",
    "javascript.preferences.importModuleSpecifier": "shortest",
    "javascript.format.semicolons": "insert",
    "typescript.format.semicolons": "insert",
    "javascript.suggest.autoImports": true,
    "typescript.suggest.autoImports": true,
    "javascript.suggest.completeFunctionCalls": true,
    "typescript.suggest.completeFunctionCalls": true,

    // ESLint settings
    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact"
    ],
    "eslint.workingDirectories": [
      { "pattern": "apps/*/" },
      { "pattern": "packages/*/" }
    ],
    "eslint.packageManager": "pnpm",
    "eslint.debug": false,
    "eslint.format.enable": true,
    "eslint.lintTask.enable": true,

    // Prettier settings
    "prettier.singleQuote": true,
    "prettier.semi": true,
    "prettier.tabWidth": 2,
    "prettier.trailingComma": "es5",
    "prettier.printWidth": 100,
    "prettier.bracketSpacing": true,
    "prettier.arrowParens": "avoid",
    "prettier.endOfLine": "lf",
    "prettier.useEditorConfig": false,

    // React settings
    "react-native-tools.projectRoot": "./apps/mobile",
    "js/ts.implicitProjectConfig.experimentalDecorators": true,

    // Terminal settings
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.env.windows": {
      "NODE_ENV": "development"
    },
    "terminal.integrated.env.linux": {
      "NODE_ENV": "development"
    },
    "terminal.integrated.env.osx": {
      "NODE_ENV": "development"
    },

    // Git settings
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.autofetch": true,
    "git.fetchOnPull": true,
    "diffEditor.ignoreTrimWhitespace": false,

    // Tailwind CSS settings
    "tailwindCSS.includeLanguages": {
      "javascript": "javascript",
      "javascriptreact": "javascript",
      "typescript": "typescript",
      "typescriptreact": "typescript"
    },
    "tailwindCSS.emmetCompletions": true,
    "tailwindCSS.validate": true,
    "tailwindCSS.experimental.classRegex": [
      ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
      ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
    ],

    // Language-specific settings
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[markdown]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.wordWrap": "on"
    },
    "[yaml]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[html]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // Specific project settings
    "search.exclude": {
      "**/node_modules": true,
      "**/.turbo": true,
      "**/dist": true,
      "**/build": true,
      "**/.next": true,
      "**/coverage": true,
      "pnpm-lock.yaml": true
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.test.ts, ${capture}.test.tsx, ${capture}.spec.ts, ${capture}.spec.tsx",
      "*.tsx": "${capture}.ts, ${capture}.test.ts, ${capture}.test.tsx, ${capture}.spec.ts, ${capture}.spec.tsx",
      "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
      "*.jsx": "${capture}.js",
      "tsconfig.json": "tsconfig.*.json",
      "package.json": "package-lock.json, pnpm-lock.yaml, yarn.lock, .npmrc, .yarnrc, .pnpmrc",
      ".eslintrc.js": ".eslintignore, .eslintcache",
      ".prettierrc": ".prettierignore",
      "README.md": "LICENSE"
    },
    "workbench.colorCustomizations": {
      "activityBar.activeBackground": "#2563eb33",
      "activityBar.activeBorder": "#2563eb",
      "activityBar.background": "#ffffff",
      "activityBar.foreground": "#2563eb",
      "activityBar.inactiveForeground": "#6b7280",
      "activityBarBadge.background": "#2563eb",
      "activityBarBadge.foreground": "#ffffff",
      "statusBar.background": "#2563eb",
      "statusBar.foreground": "#ffffff",
      "statusBarItem.hoverBackground": "#1d4ed8",
      "titleBar.activeBackground": "#2563eb33",
      "titleBar.activeForeground": "#2563eb",
      "titleBar.inactiveBackground": "#2563eb1a",
      "titleBar.inactiveForeground": "#6b7280"
    },
    "workbench.iconTheme": "material-icon-theme",
    "workbench.editor.labelFormat": "short",
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 10,
    "workbench.editor.limit.perEditorGroup": true
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "bradlc.vscode-tailwindcss",
      "ms-vscode.vscode-typescript-next",
      "formulahendry.auto-rename-tag",
      "streetsidesoftware.code-spell-checker",
      "naumovs.color-highlight",
      "mikestead.dotenv",
      "dsznajder.es7-react-js-snippets",
      "github.copilot",
      "github.vscode-pull-request-github",
      "eamodio.gitlens",
      "pkief.material-icon-theme",
      "christian-kohler.path-intellisense",
      "yoavbls.pretty-ts-errors",
      "csstools.postcss",
      "ms-vsliveshare.vsliveshare",
      "redhat.vscode-yaml",
      "arcanis.vscode-zipfs",
      "gruntfuggly.todo-tree",
      "ms-vscode.js-debug",
      "ms-vscode.js-debug-nightly",
      "ms-azuretools.vscode-docker",
      "mongodb.mongodb-vscode",
      "msjsdiag.vscode-react-native",
      "firsttris.vscode-jest-runner",
      "wix.vscode-import-cost",
      "rvest.vs-code-prettier-eslint",
      "styled-components.vscode-styled-components",
      "wayou.vscode-todo-highlight",
      "zixuanchen.vitest-explorer"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Next.js: debug server-side",
        "type": "node-terminal",
        "request": "launch",
        "command": "cd apps/web && pnpm dev",
        "cwd": "${workspaceFolder:root}"
      },
      {
        "name": "Next.js: debug client-side",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:3000",
        "webRoot": "${workspaceFolder:web}"
      },
      {
        "name": "Next.js: debug full stack",
        "type": "node-terminal",
        "request": "launch",
        "command": "cd apps/web && pnpm dev",
        "cwd": "${workspaceFolder:root}",
        "serverReadyAction": {
          "pattern": "started server on .+, url: (https?://.+)",
          "uriFormat": "%s",
          "action": "debugWithChrome"
        }
      },
      {
        "name": "API: debug server",
        "type": "node-terminal",
        "request": "launch",
        "command": "cd apps/api && pnpm dev",
        "cwd": "${workspaceFolder:root}"
      },
      {
        "name": "Mobile: debug in Expo",
        "type": "reactnative",
        "request": "launch",
        "cwd": "${workspaceFolder:mobile}",
        "platform": "expo"
      }
    ],
    "compounds": [
      {
        "name": "Full Stack: Web + API",
        "configurations": ["Next.js: debug full stack", "API: debug server"]
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Start Development",
        "type": "shell",
        "command": "pnpm dev",
        "problemMatcher": [],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Build All",
        "type": "shell",
        "command": "pnpm build",
        "problemMatcher": [],
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Lint All",
        "type": "shell",
        "command": "pnpm lint",
        "problemMatcher": ["$eslint-stylish"],
        "group": "test",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Test All",
        "type": "shell",
        "command": "pnpm test",
        "problemMatcher": [],
        "group": "test",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Docker: Start Development Environment",
        "type": "shell",
        "command": "docker-compose up -d",
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Docker: Stop Development Environment",
        "type": "shell",
        "command": "docker-compose down",
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      }
    ]
  }
}
