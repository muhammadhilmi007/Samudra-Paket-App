{
  "version": "2.0.0",
  "tasks": [
    // General development tasks
    {
      "label": "Start All Development",
      "type": "shell",
      "command": "pnpm dev",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    },
    {
      "label": "Build All",
      "type": "shell",
      "command": "pnpm build",
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },

    // Web app specific tasks
    {
      "label": "Web: Start Development",
      "type": "shell",
      "command": "pnpm --filter=web dev",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev-web"
      }
    },
    {
      "label": "Web: Build",
      "type": "shell",
      "command": "pnpm --filter=web build",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "build-web"
      }
    },
    {
      "label": "Web: Lint",
      "type": "shell",
      "command": "pnpm --filter=web lint",
      "problemMatcher": ["$eslint-stylish"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "lint"
      }
    },
    {
      "label": "Web: Type Check",
      "type": "shell",
      "command": "pnpm --filter=web typecheck",
      "problemMatcher": ["$tsc"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "typecheck"
      }
    },

